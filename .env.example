# Tạo chuỗi bí mật dài từ 32 byte trở lên, ví dụ: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HTTP_PORT=6666
HTTP_HOST=localhost
API_KEY=62efeba7669c10c67f64de5985606881d58ddaca906477beb74b90df643946f1

# Địa chỉ được ghi cứng trong file Python gốc; chưa xác minh máy chủ này còn hoạt động.
TCP_SERVER_PORT=19000
TCP_SERVER_HOST=103.247.205.15

# Số giây dùng một IP nestproxy trước khi đổi IP mới (tối thiểu 60, đúng giới hạn đổi IP của nestproxy).
NESTPROXY_ROTATE_SECONDS=60

# Tùy chọn: proxy_key của nestproxy.com. Có giá trị thì mỗi lượt đăng nhập app tự gọi API nestproxy
# để lấy proxy SOCKS5; mỗi IP dùng NESTPROXY_ROTATE_SECONDS giây rồi đổi sang IP mới. Để trống thì gọi thẳng.
NESTPROXY_PROXY_KEY=UK-d96c7111-7200-479f-b3c0-42767c92b346


# Lưu ý: uuid.getnode() của Python có thể khác giá trị Node lấy từ card mạng trên một số máy.
# Điền giá trị thập phân lấy từ máy chạy Python gốc để device id khớp hoàn toàn.
# DEVICE_ID=123456789012345
MAX_RETRIES=3
READ_TIMEOUT_MS=5000
CONNECT_TIMEOUT_MS=8000
MAX_CONCURRENT_LOGINS=3
RESPONSE_WINDOW_MS=3000
MAX_PACKET_BYTES=1048576
RESPONSE_IDLE_TIMEOUT_MS=500

# legacy: tạo IV khởi tạo theo thời gian, giống hệt hành vi của Python.
# cryptographic: khó đoán hơn, nhưng chưa xác minh máy chủ thật có chấp nhận hay không.
XTEA_RANDOM_MODE=legacy
