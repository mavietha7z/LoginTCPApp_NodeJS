# Mẫu cấu hình Caddy cho VPS. `setup-vps.sh` thay __DOMAIN__, __CERTIFICATE_FILE__, __KEY_FILE__ và __APP_PORT__
# rồi chép vào /etc/caddy/Caddyfile.
#
# Cloudflare để chế độ "Full (strict)": Caddy dùng Cloudflare Origin Certificate, không xin chứng chỉ Let's Encrypt;
# đoạn Cloudflare -> VPS được mã hóa.
#
# KHÔNG bật chỉ thị `log` ở đây: access log của Caddy ghi cả header request, trong đó có X-API-Key.

https://__DOMAIN__ {
	tls __CERTIFICATE_FILE__ __KEY_FILE__

	# Tùy chọn: chỉ cho phép một số IP gọi API (ví dụ IP backend của bạn).
	# Đi qua Cloudflare nên IP thật của người gọi nằm ở header CF-Connecting-IP; header này đáng tin vì
	# firewall chỉ cho các dải IP của Cloudflare kết nối vào VPS. Bỏ dấu # ở 2 dòng dưới và thay danh sách IP.
	# @notAllowed not header CF-Connecting-IP 203.0.113.10
	# respond @notAllowed 403

	reverse_proxy 127.0.0.1:__APP_PORT__

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
