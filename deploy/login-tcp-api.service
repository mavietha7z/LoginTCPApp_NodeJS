# Dịch vụ systemd chạy HTTP API. `setup-vps.sh` chép file này vào /etc/systemd/system/.
# Xem log: journalctl -u login-tcp-api -f

[Unit]
Description=Login TCP API (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logintcp
Group=logintcp
WorkingDirectory=/opt/login-tcp-api
ExecStart=/usr/bin/node --env-file=/opt/login-tcp-api/.env /opt/login-tcp-api/server.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3

# Giới hạn quyền: app chỉ cần đọc code và mở kết nối mạng, không ghi file nào.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK cần cho os.networkInterfaces() khi tự lấy địa chỉ MAC làm DEVICE_ID.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
